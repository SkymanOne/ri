{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-5",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "openai/gpt-5": "high"
  },
  "theme": "dark",
  "transport": "sse",
  "steeringMode": "all",
  "compaction": {
    "enabled": true
  },
  "httpIdleTimeoutMs": 120000,
  "cacheWarming": "off",
  "quietStartup": "header",
  "npmCommand": [
    "npm"
  ],
  "packages": [
    "npm:pi-example@1.2.3",
    {
      "source": "git:github.com/example/pi-tools@v1",
      "skills": [
        "!legacy/**"
      ]
    }
  ],
  "enabledModels": [
    "anthropic/*",
    "openai/gpt-5"
  ],
  "fullscreenWheelScrollLines": "auto",
  "editorPaddingX": 1,
  "warnings": {
    "anthropicExtraUsage": false
  }
}